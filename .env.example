# Lex System Environment Variables
# Copy this file to .env and fill in the values from your Supabase Dashboard

# The base URL of your Supabase project (e.g., https://xyz.supabase.co)
SUPABASE_URL="https://your-project-ref.supabase.co"

# The publicly safe anon key (for client-side auth & public operations)
SUPABASE_ANON_KEY="your-anon-key-here"

# The secret service role key (for backend admin operations that bypass RLS)
# WARNING: NEVER expose this to the frontend frontend build
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# --- Testing / Verification Environment ---
# The test UUIDs used when running `node tools/verify_db_connection.js`
TEST_TENANT_ID="00000000-0000-0000-0000-000000000000"

# --- Direct DB Connection (For Autonomous Migrations) ---
# Available in Supabase Dashboard > Settings > Database > Connection string > URI
SUPABASE_DB_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"
